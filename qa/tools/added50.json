": "eg5-toy", "name_ja": "東京おもちゃ美術館", "name_en": "Tokyo Toy Museum", "url": "https://www.art-play.or.jp/ttm/info/", "blurb_ja": "廃校舎が蘇った木のおもちゃの館。四谷の校舎で木の温もりに触れて遊ぼう。", "x": 57.4, "y": 52.3, "exp": 80.0}, {"id": "eg5-trickart", "name_ja": "東京トリックアート迷宮館", "name_en": "Tokyo Trick Art Museum", "url": "https://www.trickart.info/", "blurb_ja": "江戸の町が飛び出す錯覚美術館。角度で絵が変わる、不思議な写真を撮ろう。", "x": 68.9, "y": 78.7, "exp": 80.0}, {"id": "eg5-ueno-zoo", "name_ja": "恩賜上野動物園", "name_en": "Ueno Zoo (Ueno Zoological Gardens)", "url": "https://www.tokyo-zoo.net/ueno/", "blurb_ja": "日本最古の動物園。パンダに会える上野の森のワンダーランド。", "x": 67.6, "y": 40.4, "exp": 70.0}, {"id": "eg5-unko", "name_ja": "うんこミュージアム TOKYO", "name_en": "Unko Museum TOKYO", "url": "https://unkomuseum.com/tokyo/", "blurb_ja": "お台場に噴火するうんこ火山！？カラフルでかわいい、うんこのテーマパーク。", "x": 68.7, "y": 80.4, "exp": 90.0}, {"id": "eg5-yushima", "name_ja": "湯島天満宮（湯島天神）", "name_en": "Yushima Tenmangu (Yushima Tenjin)", "url": "https://www.yushimatenjin.or.jp/", "blurb_ja": "学問の神・菅原道真を祀る湯島の社。合格祈願の絵馬が境内にぎっしり揺れる。", "x": 67.3, "y": 44.4, "exp": 70.0}]